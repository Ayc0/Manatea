{
  "name": "manatea",
  "version": "1.0.0",
  "sideEffects": false,
  "source": "src/index.ts",
  "umd:main": "dist/manatea.umd.js",
  "main": "dist/manatea.cjs",
  "module": "dist/manatea.mjs",
  "exports": {
    ".": {
      "require": "./dist/manatea.cjs",
      "import": "./dist/manatea.mjs",
      "browser": "./dist/manatea.mjs",
      "umd": "./dist/manatea.umd.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Ayc0",
  "repository": "git@github.com:Ayc0/Manatea.git",
  "bugs": "https://github.com/Ayc0/Manatea/issues",
  "homepage": "https://github.com/Ayc0/Manatea/tree/master/packages/manatea#readme",
  "keywords": [
    "javascript",
    "state",
    "immutable",
    "lightweight",
    "atom"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsdown --watch",
    "test": "jest",
    "build:clean": "rm -rf dist",
    "build:action": "tsdown",
    "build": "pnpm build:clean && pnpm build:action"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
